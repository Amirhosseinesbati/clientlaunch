      },
      "id": "cbdbed79-db16-52c5-bfdd-cd4bb691cb1c",
      "name": "Verify and persist deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        390,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CL08InternalAuth",
          "name": "ClientLaunch internal API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.statusCode >= 400 ? {accepted:false,error:$json.body?.detail || $json.body?.message || 'Rejected'} : {accepted:true,onboarding_id:$json.body.onboarding_id,duplicate:$json.body.duplicate}) }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      },
      "id": "8a487e48-1f11-5c05-b2cd-96089c432992",
      "name": "Acknowledge verified deal",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "3525214b-2fae-5fe1-9942-7cf7eb7d8851",
              "leftValue": "={{ $('Verify and persist deal').first().json.statusCode >= 400 || $('Verify and persist deal').first().json.body.duplicate === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "f03ee498-dd99-5681-a067-06a1f23161aa",
